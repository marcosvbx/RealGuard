# RealGuard — configuração local.
# Copie para "realguard.env" (mesma pasta) e ajuste — ou rode `python main.py`
# e responda às perguntas (webcam/RTSP e credenciais) no terminal. O arquivo realguard.env
# NÃO é versionado (contém senha da câmera e token do bot).
# Uma variável já definida no terminal tem prioridade sobre este arquivo.

# ---------- Fonte de vídeo ----------
# webcam = câmera do PC (padrão) | rtsp = câmera IP (AIBOX)
# auto   = o mesmo arquivo serve nos dois: na subida testa a câmera IP abaixo; se ela
#          responder, usa a câmera IP; se não, usa a webcam (sem webcam, fica na câmera IP
#          e reconecta sozinho). Ideal para a feira (AIBOX) e para ensaiar no notebook.
CAMERA_MODE=webcam
CAMERA_INDEX=0

# Teto de fps do loop principal (não confundir com a taxa da câmera nem com o
# FPS do stream no navegador). Com detecção/reconhecimento assíncronos, pode
# ficar alto sem risco de sobrecarga: 60 = nunca segura a câmera (ela raramente passa de 30).
MAX_FPS=60
# Câmera de muitos megapixels: a IA processa uma cópia com no máximo esta largura (px).
# Mais leve e com o mesmo resultado (o YOLO já trabalha em 640). 0 = resolução original.
# O que mais pesa numa câmera de 4–8 MP é decodificar o vídeo: prefira o substream (subtype=1).
PROCESS_MAX_WIDTH=1280
# Vídeo no dashboard: largura (px) e qualidade do JPEG (40–95). Maior = mais nítido e mais CPU.
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=78

# Fuso do relógio usado em entradas, saídas, atrasos e na simulação. A AIBOX vem em UTC/China:
# sem isto, às 21h ela "acha" que já é o dia seguinte. "sistema" = usa o fuso do equipamento.
FUSO_HORARIO=America/Sao_Paulo
# Data e hora da demonstração: defina pela tela em Administração → Dados fictícios.
# RELOGIO_AJUSTE_MIN e RELOGIO_AJUSTE_DIAS são persistidos quando aplicados.

# Só para CAMERA_MODE=rtsp (se a senha tiver # $ ou espaço, use aspas simples)
CAMERA_USER=
CAMERA_PASS=
CAMERA_IP=
CAMERA_PORT=554
# Alternativa: URL completa (tem prioridade sobre os campos acima)
# RTSP_URL=rtsp://usuario:senha@192.168.50.108:554/cam/realmonitor?channel=1&subtype=1

CAMERA_ID=1
CAMERA_NAME=Camera Principal

# ---------- Assistente de configuração ----------
# true = ao rodar `python main.py` num terminal, pergunta webcam/RTSP e as
# credenciais antes de iniciar. Em implantação real, use false e edite este
# arquivo à mão (o assistente também nunca roda sem terminal, ex.: systemd).
INTERACTIVE_SETUP=true

# ---------- Exibição ----------
# Espelhamento do vídeo no dashboard (só exibição: a IA, as zonas e as fotos
# do Telegram usam a imagem original).
#   auto   = automático: webcam espelhada (como espelho), câmera IP sem inverter
#   always = espelha sempre   ·   false = nunca espelha
MIRROR_VIDEO=auto

# ---------- Processamento (padrões = ajuste validado do EduVision) ----------
# Intervalo entre detecções do YOLO (0.15 s = ~6-7x/s). 0 = sem pausa (mais CPU).
DETECTION_INTERVAL_SEC=0.15
# Núcleos por inferência (a AIBOX tem 8; sobra CPU para RTSP e o resto).
YOLO_THREADS=2
FACE_THREADS=2
# Confiança mínima do YOLO para "pessoa" (0.3 = EduVision; 0.5 perdia pessoas).
YOLO_CONFIDENCE=0.3
# Reconhecimento facial por pessoa: a cada X s enquanto não identificada...
RECOGNITION_INTERVAL_SEC=1.0
# ...e a cada Y s depois de identificada (só confirma; economiza CPU).
RESOLVED_RECHECK_SEC=5.0
# Por quanto tempo o rastreador segura a pessoa sem vê-la (s).
TRACK_TIMEOUT_SEC=3.0
# "Rosto obstruído" só após X s em cena E N tentativas sem nenhum rosto,
# contando só as tentativas em que a pessoa ocupava ao menos esta fração da
# altura da imagem (quem passa longe não tem rosto detectável: não é obstrução).
OBSTRUCTED_MIN_SEC=10
OBSTRUCTED_MIN_ATTEMPTS=6
OBSTRUCTED_MIN_PERSON_HEIGHT=0.25

# ---------- Servidor ----------
# auto = automático: câmera IP (AIBOX) => 0.0.0.0, abre direto no notebook em
# http://IP_DA_AIBOX:PORTA (sem túnel SSH); webcam (PC) => 127.0.0.1 (só esta máquina).
# Um IP explícito aqui tem prioridade.
# FEIRA / dois computadores: use 0.0.0.0 para o dashboard abrir em outro PC ou celular na
# mesma rede (http://IP_DESTE_PC:8000). No Windows, permita o Python no Firewall (rede Privada).
API_HOST=auto
API_PORT=8000

# ---------- Reconhecimento ----------
USE_FACE_RECOGNITION=true
FACE_MODEL=buffalo_sc
FACE_THRESHOLD=0.45
# Rosto de lado com similaridade entre este valor e FACE_THRESHOLD conta como
# evidência FRACA do aluno: ajuda a confirmar junto com uma leitura frontal,
# mas nunca identifica ninguém sozinha.
FACE_SOFT_THRESHOLD=0.35

# ---------- Dashboard ----------
# Depois deste horário (HH:MM) a chegada conta como atraso e quem não
# apareceu conta como ausente.
# A partir da Fase 1 o horário de atraso/ausência vem do TURNO da turma
# (dashboard > Escola). Este valor só vale se não houver turnos cadastrados.
ENTRY_TOLERANCE=19:35

# ---------- Presença + Telegram ----------
# Token do bot criado no @BotFather. O jeito mais fácil é colar pelo dashboard
# (Escola → Integrações → Telegram): o salvo lá tem prioridade sobre este.
# Vazio nos dois = presença é registrada, mas nenhuma mensagem é enviada.
TELEGRAM_BOT_TOKEN=
# Bot SÓ da equipe de segurança (alertas de rosto obstruído com botões). Também dá
# para colar pela tela. Vazio = os alertas saem pelo bot dos responsáveis acima.
TELEGRAM_SECURITY_BOT_TOKEN=
# Segundos sem repetir aviso/presença para o MESMO aluno
PRESENCE_COOLDOWN_SEC=30
# Vazio = mensagem formatada padrão (entrada/saída, turma, pontual/atraso, foto).
# Para texto próprio (simples): {nome} {acao} {hora} {data} {rm} {camera}
TELEGRAM_MESSAGE_TEMPLATE=

# Segurança/gerência: recebem o alerta de ROSTO OBSTRUÍDO (com a foto do momento).
# Um ou mais Chat IDs separados por vírgula; pode ser um grupo com o bot adicionado.
SECURITY_CHAT_IDS=
SECURITY_ALERT_COOLDOWN_SEC=60

# ---------- Assistente virtual (1ª camada de suporte) ----------
# O jeito mais fácil é configurar pela tela (Escola → Assistente virtual, perfis
# Administrador e Suporte): o que for salvo lá tem prioridade sobre estas linhas.
# Chave do Gemini (Google AI Studio → Get API key). Vazio = só perguntas frequentes.
GEMINI_API_KEY=
# Vazio = modelo padrão do sistema
GEMINI_MODEL=
# Chat ID do Telegram de quem recebe os pedidos "Falar com especialista"
ASSISTANT_SUPPORT_CHAT_ID=
# Bot próprio do suporte (opcional). Vazio = usa o bot da segurança (ou o dos responsáveis).
ASSISTANT_SUPPORT_BOT_TOKEN=

# ---------- Acesso ao dashboard ----------
# Login obrigatório. O primeiro administrador é criado no terminal:
#   python main.py --criar-admin
# Duração da sessão (horas) antes de pedir login de novo.
SESSION_HOURS=12

# ---------- HTTPS (pronto, mas desligado) ----------
# Fase acadêmica: http na rede local. Para ligar, gere um certificado gratuito
# (sh scripts/gerar_certificado.sh IP_DA_AIBOX) e preencha os dois caminhos.
SSL_CERTFILE=
SSL_KEYFILE=

# ---------- Backup ----------
# Backup automático do banco + fotos dos alertas em data/backups (contém
# vetores faciais: dado sensível). Guarda os BACKUP_KEEP mais recentes de cada tipo.
BACKUP_AUTO=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=   (vazio = data/backups)

# ---------- Logs e auditoria ----------
# Log em arquivo com rotação: logs/realguard.log (LOG_MAX_MB x LOG_BACKUPS no máximo).
LOG_LEVEL=INFO
LOG_MAX_MB=5
LOG_BACKUPS=5
# Registros de auditoria mais antigos que isso são apagados (dias).
AUDIT_RETENTION_DAYS=365

# ---------- Dados fictícios ----------
# auto = na 1ª subida com o banco SEM alunos, cria 120 alunos e 90 dias fictícios
# (sem usuários, sem Telegram, sem rostos; removíveis em Administração → Dados fictícios).
# off  = nunca cria.
DADOS_FICTICIOS=auto

# ---------- Modo feira ----------
# true = a cada subida deixa o banco pronto para a demonstração, sem clicar em nada:
# sábado e domingo viram dias de aula, intervalo entre entrada e saída de
# FEIRA_INTERVALO_MIN minutos (o visitante passa várias vezes) e simulação ao vivo ligada.
MODO_FEIRA=false
FEIRA_INTERVALO_MIN=2

# ---------- Internet por proxy (só AIBOX na feira) ----------
# A rede do laboratório não tem internet: o notebook mestre leva a do celular por um proxy.
# Mais fácil escolher na pergunta "Internet" ao rodar python main.py (testa e grava aqui).
# Vazio = internet direta. Com proxy gravado e fora do ar, a subida avisa.
#HTTPS_PROXY=http://USUARIO:SENHA@192.168.50.231:8899
#NO_PROXY=127.0.0.1,localhost,192.168.50.108
